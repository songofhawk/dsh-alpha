{
  "name": "dsh-alpha",
  "version": "0.1.0",
  "private": true,
  "description": "主控 agent 统一编排：dsh 插件形式的多机多 agent 指挥层",
  "type": "commonjs",
  "main": "./src/plugin.mjs",
  "exports": {
    ".": "./src/plugin.mjs",
    "./runner": "./src/runner.mjs",
    "./tools": "./src/tools.mjs",
    "./introspect": "./scripts/introspect-tools.mjs",
    "./preset/alpha.yml": "./preset/alpha/preset.yml",
    "./preset/alpha.cordis.yml": "./preset/alpha/agent.cordis.yml",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "src",
    "preset",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test",
    "setup": "node scripts/setup-profile-alpha.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-subagent": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-subagent-acp": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-subagent-claude-code": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-subagent-codex": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.8",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.8"
  }
}